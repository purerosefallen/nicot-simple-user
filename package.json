{
  "name": "nicot-simple-user",
  "version": "3.0.0",
  "type": "module",
  "description": "Simple user module based on NICOT",
  "author": "Nanahira <nanahira@momobako.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purerosefallen/nicot-simple-user.git"
  },
  "bugs": {
    "url": "https://github.com/purerosefallen/nicot-simple-user/issues"
  },
  "homepage": "https://github.com/purerosefallen/nicot-simple-user",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./src/*": {
      "types": "./dist/src/*.d.ts",
      "import": "./dist/src/*.mjs",
      "require": "./dist/src/*.cjs"
    }
  },
  "scripts": {
    "build": "node build.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.mjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run test"
  },
  "dependencies": {
    "aragami": "^1.2.15",
    "argon2": "^0.44.0",
    "crypto-random-string": "^6.0.0",
    "nestjs-aragami": "^2.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0 || ^0.15.0",
    "nesties": "^2.0.0",
    "nicot": "^2.0.0",
    "typeorm": "^0.3.27 || ^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "class-validator": "^0.15.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "esbuild": "^0.28.0",
    "pg": "^8.16.3",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^1.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.0",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
