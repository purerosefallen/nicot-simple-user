{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "esModuleInterop": true,
    "strict": false,
    "useDefineForClassFields": false,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "allowJs": true
}
