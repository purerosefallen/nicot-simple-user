{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "nicot-simple-user": ["./index.ts"]
    },
    "incremental": false,
    "esModuleInterop": true,
    "strict": false,
    "useDefineForClassFields": false,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "compileOnSave": true,
  "allowJs": true,
  "include": ["*.ts", "src/**/*.ts", "test/**/*.ts", "tests/**/*.ts"]
}
